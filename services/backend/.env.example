# Database connection URL for async operations (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/appdb

# Database connection URL for Alembic migrations (psycopg driver)
# Format: postgresql+psycopg://user:password@host:port/database
ALEMBIC_DATABASE_URL=postgresql+psycopg://app:app@db:5432/appdb

# Seed script configuration
# Number of items to create when seeding (default: 20)
SEED_COUNT=20
