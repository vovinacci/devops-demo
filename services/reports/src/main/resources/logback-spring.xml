<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logs to stdout (RFC-0001 D6, D11). trace_id/span_id come
  from Micrometer Tracing's MDC (keys traceId/spanId) and are emitted under
  snake_case names for parity with the Go analytics service's `trace_id`
  field, so a single Loki query correlates across both. Empty when no span
  is active.
-->
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="reports"/>

    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <logLevel><fieldName>level</fieldName></logLevel>
                <loggerName><fieldName>logger</fieldName></loggerName>
                <threadName><fieldName>thread</fieldName></threadName>
                <message><fieldName>message</fieldName></message>
                <pattern>
                    <pattern>
                        {
                        "service": "${appName}",
                        "trace_id": "%mdc{traceId:-}",
                        "span_id": "%mdc{spanId:-}"
                        }
                    </pattern>
                </pattern>
                <mdc>
                    <excludeMdcKeyName>traceId</excludeMdcKeyName>
                    <excludeMdcKeyName>spanId</excludeMdcKeyName>
                </mdc>
                <stackTrace/>
                <arguments/>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="json"/>
    </root>
</configuration>
