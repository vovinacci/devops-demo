// Renovate configuration (ADR-0009): automated dependency updates
// across all ecosystems, small and continuous. Dependabot is the
// documented fallback (.github/dependabot.yml removed when this landed).
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Ship pinned, run pinned (ADR-0009)
    'docker:pinDigests',
    'helpers:pinGitHubActionDigests',
  ],
  // PR titles must be Conventional Commits (commitlint gate)
  semanticCommits: 'enabled',
  // no in-config schedule: the workflow cron (renovate.yml) is the single
  // cadence control, so a manual dispatch acts immediately
  // no dependency-dashboard issue: updates arrive as PRs, nothing else
  dependencyDashboard: false,
  // Hook versions in .pre-commit-config.yaml are dependencies too
  'pre-commit': {
    enabled: true,
  },
  // Version pins that live outside any file format Renovate parses on its
  // own. Each one is real -- a chart version in a shell script, a node image
  // in a Kind cluster config, a release tag in a documented recipe -- and
  // without these rules they sit unwatched while everything around them is
  // kept current.
  //
  // A regex manager cannot be verified by reading it, and it cannot be
  // verified by dispatching the Renovate workflow either: Renovate reads
  // repository config from the DEFAULT branch, so a rule on a feature branch
  // is not the one that runs. Check it against the working tree instead:
  //
  //   npx --package renovate renovate --platform=local --dry-run=extract
  //
  // and read the per-manager fileCount/depCount in the stats it prints.
  customManagers: [
    {
      customType: 'regex',
      description: 'kube-prometheus-stack, installed by make kind-up',
      // NOTE: a bump here also requires re-cutting the vendored CRD schemas
      // under deploy/k8s/schemas/monitoring.coreos.com/ from the new chart's
      // appVersion (recipe in deploy/k8s/README.md). Renovate cannot do that;
      // without it the offline gate validates CRs against a shape the cluster
      // no longer has -- green, and wrong.
      managerFilePatterns: ['/^deploy/k8s/scripts/kind-up\\.sh$/'],
      matchStrings: ['KUBE_PROMETHEUS_STACK_VERSION="(?<currentValue>[^"]+)"'],
      depNameTemplate: 'kube-prometheus-stack',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://prometheus-community.github.io/helm-charts',
    },
    {
      customType: 'regex',
      description: 'Envoy Gateway (OCI chart), installed by make kind-up',
      // A bump may also move the bundled Gateway API version, which the
      // vendored gateway.networking.k8s.io schemas track -- see the recipe in
      // deploy/k8s/README.md.
      managerFilePatterns: ['/^deploy/k8s/scripts/kind-up\\.sh$/'],
      matchStrings: ['ENVOY_GATEWAY_VERSION="(?<currentValue>[^"]+)"'],
      depNameTemplate: 'docker.io/envoyproxy/gateway-helm',
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Postgres pin in the analytics test harness (throwaway docker run)',
      // The same image that compose and the postgres chart pin.
      // deploy/k8s/scripts/validate.sh fails when the copies disagree, so
      // this one has to be managed rather than left to rot.
      managerFilePatterns: ['/^services/analytics/Makefile$/'],
      matchStrings: ['postgres:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})'],
      depNameTemplate: 'postgres',
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'prometheus-operator tag in the vendored-schema recipe (deploy/k8s/README.md)',
      managerFilePatterns: ['/^deploy/k8s/README\\.md$/'],
      matchStrings: ['TAG=(?<currentValue>v[0-9][^\\s]*)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'prometheus-operator/prometheus-operator',
    },
    {
      customType: 'regex',
      description: 'gateway-api tag in the vendored-schema recipe (deploy/k8s/README.md)',
      // Separate from the rule above on purpose: the two recipes track
      // different upstreams, and one rule with two matchStrings would label
      // both with a single depName.
      managerFilePatterns: ['/^deploy/k8s/README\\.md$/'],
      matchStrings: ['GWAPI=(?<currentValue>v[0-9][^\\s]*)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes-sigs/gateway-api',
    },
  ],

  // The Kind cluster config carries a digest-pinned Kubernetes node image.
  // It is a kind.x-k8s.io Cluster rather than a workload manifest, so the
  // kubernetes manager has to be pointed at it explicitly.
  kubernetes: {
    managerFilePatterns: ['/^deploy/k8s/kind/cluster\\.yaml$/'],
  },

  packageRules: [
    {
      matchFileNames: ['services/backend/**'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'backend',
    },
    {
      matchFileNames: ['services/frontend/**'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'frontend',
    },
    {
      matchFileNames: ['services/canary/**'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'canary',
    },
    {
      matchFileNames: ['services/analytics/**'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'analytics',
    },
    {
      matchFileNames: ['services/reports/**'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'reports',
    },
    // Pin frontend npm ranges to exact versions: with caret ranges an
    // in-range release needs no package.json change, so minor/patch
    // updates never surfaced as PRs (npm ci reads the stale lockfile).
    // Apps pin; ship pinned, run pinned (ADR-0009).
    {
      matchFileNames: ['services/frontend/**'],
      matchManagers: ['npm'],
      rangeStrategy: 'pin',
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
    },
    {
      matchManagers: ['pre-commit'],
      groupName: 'git-hooks',
    },
    {
      // helm-values belongs here with the other image managers: every
      // third-party image in deploy/k8s/charts/*/values.yaml is a second
      // copy of a compose pin (postgres, postgres-exporter, mailpit, loki,
      // blackbox), and deploy/k8s/scripts/validate.sh fails when the two
      // disagree. Grouping the managers together is what makes both copies
      // of one image arrive in one PR -- #223 (postgres) and #231 (loki)
      // were each a bump that reached the chart alone and stayed red until
      // the compose side was pushed by hand.
      matchManagers: ['dockerfile', 'docker-compose', 'helm-values'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin'],
      groupName: 'docker',
    },
    {
      // The fourth postgres copy lives in the analytics test harness and is
      // reported by the customManager above, which no matchManagers list
      // covers. Group it by name so it rides along with the other three.
      matchDepNames: ['postgres'],
      groupName: 'docker',
    },
    // Runtime version policy (last rules win over the groups above):
    // Python and Go move by patch only -- minor/major runtime bumps are
    // deliberate decisions, not dependency chores
    {
      // full image name: the devcontainer manager reports the base image
      // as its registry path, not as 'python'
      matchDepNames: ['python', 'go', 'golang', 'mcr.microsoft.com/devcontainers/python'],
      matchUpdateTypes: ['major', 'minor'],
      enabled: false,
    },
    // Node: minor/patch flow automatically, majors are manual
    {
      matchDepNames: ['node', 'nodejs'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    // Java: the JDK major is a deliberate decision, not a dependency chore.
    // It is also the one runtime named differently in each of its two
    // places -- 'java' in .mise.toml, 'eclipse-temurin' in the reports
    // Dockerfile -- where python/go/node each use one name for both, so it
    // takes two rules to get the coverage one rule buys elsewhere.
    // scripts/check-toolchain-drift.sh requires the two to agree on the
    // major, and Renovate cannot move them together: mise spells the version
    // with a "+" build suffix, which is not a legal Docker tag character, so
    // no image tag can ever match a bumped mise pin. Freeze the mise pin
    // entirely and hold the image at its major; the image keeps taking patch
    // and digest bumps from the docker group above.
    {
      matchDepNames: ['java'],
      enabled: false,
    },
    {
      matchDepNames: ['eclipse-temurin'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
}
